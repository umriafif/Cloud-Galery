{
  "name": "cloud-gallery",
  "version": "1.0.0",
  "description": "Basic self-hosted cloud gallery with folders, roles, image/video uploads, and Docker support.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/assets/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/assets/app.css --watch"
  },
  "keywords": [
    "gallery",
    "ejs",
    "tailwind",
    "mariadb",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.1",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.17"
  }
}

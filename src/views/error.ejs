<section class="mx-auto max-w-2xl">
  <div class="panel p-8 text-center sm:p-12">
    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-rose-100 text-2xl dark:bg-rose-950/40">
      !
    </div>
    <div class="mt-6 text-sm font-semibold uppercase tracking-[0.2em] text-rose-500">
      Error <%= statusCode %>
    </div>
    <h1 class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
      <%= title %>
    </h1>
    <p class="mx-auto mt-4 max-w-lg text-sm leading-7 text-slate-600 dark:text-slate-300">
      <%= message %>
    </p>
    <div class="mt-8 flex justify-center">
      <a href="<%= currentUser ? '/dashboard' : '/login' %>" class="btn-primary">
        Kembali
      </a>
    </div>
  </div>
</section>

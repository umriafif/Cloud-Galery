<section class="grid gap-6">
  <div class="panel p-6 sm:p-8">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
          <a href="/dashboard" class="hover:text-accent-600 dark:hover:text-accent-400">Dashboard</a>
          <% breadcrumbs.forEach((crumb) => { %>
            <span>/</span>
            <a href="/folders/<%= crumb.id %>" class="hover:text-accent-600 dark:hover:text-accent-400"><%= crumb.name %></a>
          <% }) %>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 dark:text-white"><%= folder.name %></h1>
          <span class="chip">Owner: <%= folder.owner_name %></span>
        </div>

        <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">
          Halaman folder memuat subfolder dan media secara bertahap. Untuk folder dengan ribuan item, sistem hanya mengambil batch kecil berdasarkan cursor agar tetap responsif.
        </p>
      </div>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[0.9fr,1.1fr]">
    <div class="grid gap-6">
      <div class="panel p-6">
        <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Tambah Subfolder</h2>
        <form action="/folders" method="post" class="mt-5 flex flex-col gap-3">
          <input type="hidden" name="parent_id" value="<%= folder.id %>" />
          <input name="name" type="text" class="input" placeholder="Nama subfolder" required />
          <button type="submit" class="btn-secondary">Buat Subfolder</button>
        </form>
      </div>

      <div class="panel p-6">
        <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Upload ke Folder</h2>
        <form action="/folders/<%= folder.id %>/upload" method="post" enctype="multipart/form-data" class="mt-5 space-y-4" data-upload-form>
          <label
            class="panel-muted block cursor-pointer border-2 border-dashed p-5 text-center transition hover:border-accent-300 dark:hover:border-accent-700"
            data-dropzone
          >
            <input
              id="folder-upload"
              data-file-input
              type="file"
              name="media_files"
              accept="<%= acceptedMediaHint %>"
              multiple
              class="hidden"
            />
            <div class="text-sm font-semibold text-slate-900 dark:text-white">Drop foto atau video di sini</div>
            <div data-file-label="folder-upload" class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Belum ada file dipilih
            </div>
            <div class="mt-3 text-xs text-slate-500 dark:text-slate-400">
              Mendukung format umum seperti JPG, PNG, WEBP, GIF, AVIF, MP4, MOV, MKV, WEBM, AVI, MTS, dan lainnya.
            </div>
            <div class="mt-2 text-xs text-slate-500 dark:text-slate-400">
              Maksimal <%= maxFilesPerRequest %> file per upload, hingga <%= maxUploadSizeMb %> MB per file.
            </div>
          </label>

          <div class="hidden" data-upload-progress>
            <div class="progress-shell h-3">
              <div class="progress-bar w-0" data-upload-progress-bar></div>
            </div>
            <div class="mt-2 flex items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400">
              <span data-upload-progress-text>Menyiapkan upload...</span>
              <span data-upload-progress-percent>0%</span>
            </div>
          </div>

          <div class="hidden rounded-2xl border px-4 py-3 text-sm" data-upload-feedback></div>

          <button type="submit" class="btn-primary w-full" data-upload-submit>Upload ke Folder Ini</button>
        </form>
      </div>

      <div class="panel p-6">
        <div class="flex items-center justify-between gap-3">
          <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Subfolder</h2>
          <span class="chip"><%= subfolders.length %> item</span>
        </div>

        <% if (subfolders.length === 0) { %>
          <div class="panel-muted mt-5 p-6 text-sm text-slate-500 dark:text-slate-400">
            Belum ada subfolder di dalam lokasi ini.
          </div>
        <% } else { %>
          <div class="mt-5 grid gap-4">
            <% subfolders.forEach((item) => { %>
              <%- include('../partials/folder-card', { folder: item }) %>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <div class="panel p-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-white">Media</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Klik item untuk membuka preview dan detail.</p>
        </div>
        <span class="chip"><%= mediaPage.items.length %> ditampilkan</span>
      </div>

      <form action="/folders/<%= folder.id %>" method="get" class="mt-5 flex flex-col gap-3 sm:flex-row">
        <input
          name="q"
          type="search"
          value="<%= mediaQuery %>"
          class="input"
          placeholder="Cari nama file di folder ini"
        />
        <button type="submit" class="btn-secondary shrink-0">Cari Nama File</button>
        <% if (mediaQuery) { %>
          <a href="/folders/<%= folder.id %>" class="btn-secondary shrink-0">Reset</a>
        <% } %>
      </form>

      <% if (mediaQuery) { %>
        <div class="mt-4 text-sm text-slate-500 dark:text-slate-400">
          Hasil pencarian untuk nama file: <span class="font-semibold text-slate-900 dark:text-white"><%= mediaQuery %></span>
        </div>
      <% } %>

      <% if (mediaPage.items.length === 0) { %>
        <div class="panel-muted mt-5 p-8 text-center text-sm text-slate-500 dark:text-slate-400">
          <%= mediaQuery ? 'Tidak ada media di folder ini yang cocok dengan pencarian.' : 'Folder ini belum memiliki media.' %>
        </div>
      <% } else { %>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          <% mediaPage.items.forEach((media) => { %>
            <%- include('../partials/media-card', { media }) %>
          <% }) %>
        </div>

        <% if (mediaPage.hasMore && mediaPage.nextCursor) { %>
          <div class="mt-6 flex justify-center">
            <a href="/folders/<%= folder.id %>?cursor=<%= encodeURIComponent(mediaPage.nextCursor) %><%= mediaQuery ? `&q=${encodeURIComponent(mediaQuery)}` : '' %>" class="btn-secondary">
              Muat Batch Berikutnya
            </a>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</section>

<a
  href="/folders/<%= folder.id %>"
  class="group panel block overflow-hidden p-5 transition duration-200 hover:-translate-y-1 hover:shadow-2xl"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex min-w-0 items-center gap-4">
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-3xl bg-amber-100 text-2xl dark:bg-amber-500/10">
        📁
      </div>
      <div class="min-w-0">
        <div class="truncate text-base font-bold text-slate-900 dark:text-white">
          <%= folder.name %>
        </div>
        <div class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          <%= folder.child_count %> subfolder • <%= folder.media_count %> media
        </div>
      </div>
    </div>
    <div class="text-slate-300 transition group-hover:text-accent-500 dark:text-slate-700">→</div>
  </div>

  <% if (folder.owner_name) { %>
    <div class="mt-5 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
      <span>Owner: <%= folder.owner_name %></span>
      <span><%= formatDate(folder.updated_at) %></span>
    </div>
  <% } %>
</a>

<a
  href="/media/<%= media.id %>"
  class="group panel block overflow-hidden transition duration-200 hover:-translate-y-1 hover:shadow-2xl"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-slate-200 dark:bg-slate-800">
    <img
      src="/media/<%= media.id %>/thumb"
      alt="<%= media.title %>"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
      loading="lazy"
    />
    <div class="absolute inset-x-0 top-0 flex items-center justify-between p-3">
      <span class="chip border-white/60 bg-black/45 text-white backdrop-blur">
        <%= media.media_type === 'video' ? 'Video' : 'Image' %>
      </span>
      <% if (media.media_type === 'video') { %>
        <span class="rounded-full bg-black/55 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
          <%= formatDuration(media.duration_seconds) %>
        </span>
      <% } %>
    </div>
  </div>

  <div class="space-y-3 p-4">
    <div>
      <div class="truncate font-semibold text-slate-900 dark:text-white"><%= media.title %></div>
      <div class="truncate text-sm text-slate-500 dark:text-slate-400"><%= media.original_name %></div>
    </div>

    <div class="flex items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400">
      <span><%= formatBytes(media.file_size) %></span>
      <span><%= formatDate(media.created_at) %></span>
    </div>
  </div>
</a>

<% if (flash) { %>
  <div
    class="mb-6 rounded-3xl border px-5 py-4 text-sm font-medium <%= flash.type === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-200' : flash.type === 'warning' ? 'border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200' : 'border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-200' %>"
  >
    <%= flash.message %>
  </div>
<% } %>

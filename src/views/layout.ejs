<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title ? `${title} • ${appName}` : appName %></title>
    <meta
      name="description"
      content="Cloud Gallery: upload foto dan video, kelola folder, dan akses media dengan role admin dan user."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script>
      (function () {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <link rel="stylesheet" href="/assets/app.css" />
  </head>
  <body class="min-h-screen">
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute left-0 top-0 h-[26rem] w-[26rem] rounded-full bg-accent-200/60 blur-3xl dark:bg-accent-900/30"></div>
      <div class="absolute right-0 top-20 h-[24rem] w-[24rem] rounded-full bg-amber-200/50 blur-3xl dark:bg-amber-900/20"></div>
      <div class="absolute bottom-0 left-1/3 h-[20rem] w-[20rem] rounded-full bg-cyan-200/40 blur-3xl dark:bg-cyan-900/20"></div>
    </div>

    <%- include('partials/nav') %>

    <main class="mx-auto w-full max-w-7xl px-4 pb-10 pt-6 sm:px-6 lg:px-8">
      <%- include('partials/flash') %>
      <%- body %>
    </main>

    <script src="/js/theme.js" defer></script>
  </body>
</html>

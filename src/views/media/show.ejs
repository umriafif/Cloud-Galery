<section class="grid gap-6">
  <div class="flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
    <a href="/dashboard" class="hover:text-accent-600 dark:hover:text-accent-400">Dashboard</a>
    <% breadcrumbs.forEach((crumb) => { %>
      <span>/</span>
      <a href="/folders/<%= crumb.id %>" class="hover:text-accent-600 dark:hover:text-accent-400"><%= crumb.name %></a>
    <% }) %>
    <% if (media.folder_id) { %>
      <span>/</span>
      <span class="text-slate-700 dark:text-slate-200"><%= media.title %></span>
    <% } %>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1.2fr,0.8fr]">
    <div class="panel overflow-hidden p-4 sm:p-6">
      <div class="overflow-hidden rounded-[28px] bg-slate-100 dark:bg-slate-900">
        <% if (media.media_type === 'image') { %>
          <img
            src="/media/<%= media.id %>/file"
            alt="<%= media.title %>"
            class="max-h-[75vh] w-full object-contain"
          />
        <% } else { %>
          <video
            src="/media/<%= media.id %>/file"
            poster="/media/<%= media.id %>/thumb"
            controls
            preload="metadata"
            class="max-h-[75vh] w-full rounded-[28px] bg-black object-contain"
            data-video-player
          ></video>
        <% } %>
      </div>
    </div>

    <div class="grid gap-6">
      <div class="panel p-6">
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip"><%= media.media_type === 'video' ? 'Video' : 'Image' %></span>
          <% if (media.folder_id) { %>
            <a href="/folders/<%= media.folder_id %>" class="chip hover:border-accent-300 hover:text-accent-700 dark:hover:border-accent-700 dark:hover:text-accent-300">
              Folder: <%= media.folder_name %>
            </a>
          <% } %>
        </div>

        <h1 class="mt-4 font-display text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          <%= media.title %>
        </h1>

        <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
          <%= media.original_name %>
        </p>

        <% if (media.media_type === 'video') { %>
          <div class="mt-5">
            <button type="button" data-video-toggle class="btn-primary">Play</button>
          </div>
        <% } %>

        <div class="mt-6">
          <a href="/media/<%= media.id %>/file" class="btn-secondary">Buka File Asli</a>
        </div>
      </div>

      <div class="panel p-6">
        <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Metadata</h2>
        <dl class="mt-5 grid gap-4 text-sm">
          <div class="panel-muted flex items-center justify-between px-4 py-3">
            <dt class="text-slate-500 dark:text-slate-400">Owner</dt>
            <dd class="font-semibold text-slate-900 dark:text-white"><%= media.owner_name %></dd>
          </div>
          <div class="panel-muted flex items-center justify-between px-4 py-3">
            <dt class="text-slate-500 dark:text-slate-400">Uploader</dt>
            <dd class="font-semibold text-slate-900 dark:text-white"><%= media.uploaded_by_name %></dd>
          </div>
          <div class="panel-muted flex items-center justify-between px-4 py-3">
            <dt class="text-slate-500 dark:text-slate-400">Ukuran</dt>
            <dd class="font-semibold text-slate-900 dark:text-white"><%= formatBytes(media.file_size) %></dd>
          </div>
          <div class="panel-muted flex items-center justify-between px-4 py-3">
            <dt class="text-slate-500 dark:text-slate-400">Resolusi</dt>
            <dd class="font-semibold text-slate-900 dark:text-white"><%= media.width || '-' %> × <%= media.height || '-' %></dd>
          </div>
          <div class="panel-muted flex items-center justify-between px-4 py-3">
            <dt class="text-slate-500 dark:text-slate-400">Durasi</dt>
            <dd class="font-semibold text-slate-900 dark:text-white"><%= formatDuration(media.duration_seconds) %></dd>
          </div>
          <div class="panel-muted flex items-center justify-between px-4 py-3">
            <dt class="text-slate-500 dark:text-slate-400">Tanggal Upload</dt>
            <dd class="font-semibold text-slate-900 dark:text-white"><%= formatDate(media.created_at) %></dd>
          </div>
          <div class="panel-muted flex items-center justify-between px-4 py-3">
            <dt class="text-slate-500 dark:text-slate-400">MIME Type</dt>
            <dd class="font-semibold text-slate-900 dark:text-white"><%= media.mime_type %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<section class="grid gap-6">
  <div class="grid gap-6 lg:grid-cols-[1.1fr,0.9fr]">
    <div class="panel overflow-hidden p-6 sm:p-8">
      <div class="flex flex-col gap-6">
        <div>
          <span class="chip">Workspace overview</span>
          <h1 class="mt-4 font-display text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Halo, <%= currentUser.name %>. Kelola foto dan video dari satu dashboard.
          </h1>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">
            Folder bersifat logis di database, sementara file fisik di-shard agar siap menangani folder besar dengan ribuan media tanpa membebani satu direktori.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="panel-muted p-5">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Folder</div>
            <div class="mt-2 font-display text-4xl font-bold text-slate-900 dark:text-white"><%= stats.totalFolders %></div>
          </div>
          <div class="panel-muted p-5">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Media</div>
            <div class="mt-2 font-display text-4xl font-bold text-slate-900 dark:text-white"><%= stats.totalMedia %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid gap-6">
      <div class="panel p-6">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Upload ke Root</h2>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Drag-and-drop atau pilih banyak foto dan video sekaligus.</p>
          </div>
          <span class="chip">Batch upload</span>
        </div>

        <form action="/upload" method="post" enctype="multipart/form-data" class="mt-5 space-y-4" data-upload-form>
          <label
            class="panel-muted block cursor-pointer border-2 border-dashed p-5 text-center transition hover:border-accent-300 dark:hover:border-accent-700"
            data-dropzone
          >
            <input
              id="dashboard-upload"
              data-file-input
              type="file"
              name="media_files"
              accept="<%= acceptedMediaHint %>"
              multiple
              class="hidden"
            />
            <div class="text-sm font-semibold text-slate-900 dark:text-white">Drop file di sini atau klik untuk memilih</div>
            <div data-file-label="dashboard-upload" class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Belum ada file dipilih
            </div>
            <div class="mt-3 text-xs text-slate-500 dark:text-slate-400">
              Format umum didukung: JPG, PNG, WEBP, GIF, AVIF, HEIC, MP4, MOV, MKV, WEBM, AVI, dan lainnya.
            </div>
            <div class="mt-2 text-xs text-slate-500 dark:text-slate-400">
              Maksimal <%= maxFilesPerRequest %> file per upload, hingga <%= maxUploadSizeMb %> MB per file.
            </div>
          </label>

          <div class="hidden" data-upload-progress>
            <div class="progress-shell h-3">
              <div class="progress-bar w-0" data-upload-progress-bar></div>
            </div>
            <div class="mt-2 flex items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400">
              <span data-upload-progress-text>Menyiapkan upload...</span>
              <span data-upload-progress-percent>0%</span>
            </div>
          </div>

          <div class="hidden rounded-2xl border px-4 py-3 text-sm" data-upload-feedback></div>

          <button type="submit" class="btn-primary w-full" data-upload-submit>Upload Sekarang</button>
        </form>
      </div>

      <div class="panel p-6">
        <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Buat Folder</h2>
        <form action="/folders" method="post" class="mt-5 flex flex-col gap-3 sm:flex-row">
          <input name="name" type="text" class="input" placeholder="Nama folder baru" required />
          <button type="submit" class="btn-secondary shrink-0">Tambah Folder</button>
        </form>
      </div>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[0.95fr,1.05fr]">
    <div class="panel p-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-white">Folder Root</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Masuk ke folder untuk upload, subfolder, dan browsing media.</p>
        </div>
        <span class="chip"><%= rootFolders.length %> folder</span>
      </div>

      <% if (rootFolders.length === 0) { %>
        <div class="panel-muted mt-5 p-8 text-center text-sm text-slate-500 dark:text-slate-400">
          Belum ada folder. Buat folder pertama dari form di atas.
        </div>
      <% } else { %>
        <div class="mt-5 grid gap-4">
          <% rootFolders.forEach((folder) => { %>
            <%- include('../partials/folder-card', { folder }) %>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="panel p-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-white">Media Root</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Semua media yang diunggah tanpa folder khusus.</p>
        </div>
        <span class="chip"><span id="dashboard-media-count"><%= rootMediaPage.items.length %></span> item</span>
      </div>

      <form action="/dashboard" method="get" class="mt-5 flex flex-col gap-3 sm:flex-row">
        <input
          name="q"
          type="search"
          value="<%= mediaQuery %>"
          class="input"
          placeholder="Cari berdasarkan nama file, misalnya liburan-2026 atau video-event"
        />
        <button type="submit" class="btn-secondary shrink-0">Cari Nama File</button>
        <% if (mediaQuery) { %>
          <a href="/dashboard" class="btn-secondary shrink-0">Reset</a>
        <% } %>
      </form>

      <% if (mediaQuery) { %>
        <div class="mt-4 text-sm text-slate-500 dark:text-slate-400">
          Hasil pencarian untuk nama file: <span class="font-semibold text-slate-900 dark:text-white"><%= mediaQuery %></span>
        </div>
      <% } %>

      <% if (rootMediaPage.items.length === 0) { %>
        <div class="panel-muted mt-5 p-8 text-center text-sm text-slate-500 dark:text-slate-400">
          <%= mediaQuery ? 'Tidak ada media root yang cocok dengan pencarian ini.' : 'Belum ada media di root. Anda bisa upload langsung dari panel di atas.' %>
        </div>
      <% } else { %>
        <div
          class="mt-5"
          data-infinite-scroll
          data-endpoint="/dashboard?partial=media<%= mediaQuery ? `&q=${encodeURIComponent(mediaQuery)}` : '' %>"
          data-next-cursor="<%= rootMediaPage.nextCursor || '' %>"
          data-has-more="<%= rootMediaPage.hasMore ? 'true' : 'false' %>"
          data-count-target="dashboard-media-count"
        >
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3" data-infinite-grid>
            <%- include('../partials/media-grid-items', { items: rootMediaPage.items }) %>
          </div>

          <div class="mt-6 text-center text-sm text-slate-500 dark:text-slate-400" data-infinite-status>
            <%= rootMediaPage.hasMore ? 'Scroll ke bawah untuk memuat media berikutnya.' : 'Semua media yang tersedia sudah dimuat.' %>
          </div>

          <% if (rootMediaPage.hasMore && rootMediaPage.nextCursor) { %>
            <div class="mt-6 flex justify-center" data-infinite-fallback-wrapper>
              <a
                href="/dashboard?cursor=<%= encodeURIComponent(rootMediaPage.nextCursor) %><%= mediaQuery ? `&q=${encodeURIComponent(mediaQuery)}` : '' %>"
                class="btn-secondary"
                data-infinite-fallback
              >
                Muat Media Root Berikutnya
              </a>
            </div>
          <% } %>

          <div class="h-4" data-infinite-sentinel aria-hidden="true"></div>
        </div>
      <% } %>
    </div>
  </div>
</section>

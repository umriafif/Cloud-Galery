<section class="grid gap-6">
  <div class="grid gap-6 lg:grid-cols-[1.1fr,0.9fr]">
    <div class="panel overflow-hidden p-6 sm:p-8">
      <div class="flex flex-col gap-6">
        <div>
          <span class="chip">Workspace overview</span>
          <h1 class="mt-4 font-display text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Halo, <%= currentUser.name %>. Kelola foto dan video dari satu dashboard.
          </h1>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">
            Folder bersifat logis di database, sementara file fisik di-shard agar siap menangani folder besar dengan ribuan media tanpa membebani satu direktori.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="panel-muted p-5">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Folder</div>
            <div class="mt-2 font-display text-4xl font-bold text-slate-900 dark:text-white"><%= stats.totalFolders %></div>
          </div>
          <div class="panel-muted p-5">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Media</div>
            <div class="mt-2 font-display text-4xl font-bold text-slate-900 dark:text-white"><%= stats.totalMedia %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid gap-6">
      <div class="panel p-6">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Upload ke Root</h2>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Unggah banyak foto atau video sekaligus.</p>
          </div>
          <span class="chip">Batch upload</span>
        </div>

        <form action="/upload" method="post" enctype="multipart/form-data" class="mt-5 space-y-4">
          <label class="panel-muted block cursor-pointer border-dashed p-5 text-center transition hover:border-accent-300 dark:hover:border-accent-700">
            <input id="dashboard-upload" data-file-input type="file" name="media_files" multiple class="hidden" />
            <div class="text-sm font-semibold text-slate-900 dark:text-white">Pilih file</div>
            <div data-file-label="dashboard-upload" class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Belum ada file dipilih
            </div>
          </label>
          <button type="submit" class="btn-primary w-full">Upload Sekarang</button>
        </form>
      </div>

      <div class="panel p-6">
        <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Buat Folder</h2>
        <form action="/folders" method="post" class="mt-5 flex flex-col gap-3 sm:flex-row">
          <input name="name" type="text" class="input" placeholder="Nama folder baru" required />
          <button type="submit" class="btn-secondary shrink-0">Tambah Folder</button>
        </form>
      </div>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[0.95fr,1.05fr]">
    <div class="panel p-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-white">Folder Root</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Masuk ke folder untuk upload, subfolder, dan browsing media.</p>
        </div>
        <span class="chip"><%= rootFolders.length %> folder</span>
      </div>

      <% if (rootFolders.length === 0) { %>
        <div class="panel-muted mt-5 p-8 text-center text-sm text-slate-500 dark:text-slate-400">
          Belum ada folder. Buat folder pertama dari form di atas.
        </div>
      <% } else { %>
        <div class="mt-5 grid gap-4">
          <% rootFolders.forEach((folder) => { %>
            <%- include('../partials/folder-card', { folder }) %>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="panel p-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-white">Media Root</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Semua media yang diunggah tanpa folder khusus.</p>
        </div>
        <span class="chip"><%= rootMediaPage.items.length %> item</span>
      </div>

      <% if (rootMediaPage.items.length === 0) { %>
        <div class="panel-muted mt-5 p-8 text-center text-sm text-slate-500 dark:text-slate-400">
          Belum ada media di root. Anda bisa upload langsung dari panel di atas.
        </div>
      <% } else { %>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          <% rootMediaPage.items.forEach((media) => { %>
            <%- include('../partials/media-card', { media }) %>
          <% }) %>
        </div>

        <% if (rootMediaPage.hasMore && rootMediaPage.nextCursor) { %>
          <div class="mt-6 flex justify-center">
            <a href="/dashboard?cursor=<%= encodeURIComponent(rootMediaPage.nextCursor) %>" class="btn-secondary">
              Muat Media Root Berikutnya
            </a>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</section>

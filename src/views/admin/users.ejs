<section class="grid gap-6 lg:grid-cols-[0.9fr,1.1fr]">
  <div class="panel p-6">
    <div>
      <span class="chip">Admin tools</span>
      <h1 class="mt-4 font-display text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Manajemen User
      </h1>
      <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
        Buat akun baru, ubah role admin/user, dan aktif/nonaktifkan akses.
      </p>
    </div>

    <form action="/admin/users" method="post" class="mt-8 grid gap-4">
      <div>
        <label for="name" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">Nama</label>
        <input id="name" name="name" type="text" class="input" placeholder="Nama user" required />
      </div>
      <div>
        <label for="email" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">Email</label>
        <input id="email" name="email" type="email" class="input" placeholder="email@contoh.com" required />
      </div>
      <div>
        <label for="password" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">Password</label>
        <input id="password" name="password" type="password" class="input" placeholder="Minimal 8 karakter" required />
      </div>
      <div>
        <label for="role" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">Role</label>
        <select id="role" name="role" class="input">
          <option value="user">User</option>
          <option value="admin">Admin</option>
        </select>
      </div>
      <button type="submit" class="btn-primary">Buat User</button>
    </form>
  </div>

  <div class="panel p-6">
    <div class="flex items-center justify-between gap-3">
      <div>
        <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-white">Daftar User</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= users.length %> akun terdaftar.</p>
      </div>
    </div>

    <div class="mt-5 grid gap-4">
      <% users.forEach((user) => { %>
        <article class="panel-muted p-5">
          <div class="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white"><%= user.name %></h3>
                <span class="chip uppercase"><%= user.role %></span>
                <span class="chip <%= user.is_active ? '' : 'border-rose-300 text-rose-700 dark:border-rose-800 dark:text-rose-300' %>">
                  <%= user.is_active ? 'Active' : 'Disabled' %>
                </span>
              </div>
              <div class="mt-2 text-sm text-slate-500 dark:text-slate-400"><%= user.email %></div>
              <div class="mt-3 flex flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400">
                <span class="chip"><%= user.folder_count %> folder</span>
                <span class="chip"><%= user.media_count %> media</span>
                <span class="chip">Bergabung <%= formatDate(user.created_at) %></span>
              </div>
            </div>

            <div class="grid gap-3 sm:grid-cols-2 xl:w-[20rem]">
              <form action="/admin/users/<%= user.id %>/role" method="post" class="grid gap-2">
                <select name="role" class="input">
                  <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>User</option>
                  <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
                </select>
                <button type="submit" class="btn-secondary">Simpan Role</button>
              </form>

              <form action="/admin/users/<%= user.id %>/status" method="post" class="grid gap-2">
                <select name="is_active" class="input">
                  <option value="1" <%= user.is_active ? 'selected' : '' %>>Active</option>
                  <option value="0" <%= !user.is_active ? 'selected' : '' %>>Disabled</option>
                </select>
                <button type="submit" class="btn-secondary">Simpan Status</button>
              </form>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
